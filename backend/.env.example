# =============================================================================
#  BACKEND ENVIRONMENT - FILE MẪU (được commit lên git)
# -----------------------------------------------------------------------------
#  • Tạo file .env thật:   npm run setup      (tự copy + tự sinh secret)
#  • Kiểm tra đồng bộ:     npm run env:check  (so .env với file này)
#  • Đồng bộ key thiếu:    npm run env:sync
#  • Thêm biến mới: sửa file này + backend/src/config/env.js (test sẽ báo nếu lệch)
#
#  Mức độ quan trọng:
#    [REQUIRED]    🔴 Bắt buộc - app KHÔNG khởi động nếu thiếu/sai
#    [SECRET]      🔴 Bắt buộc + BÍ MẬT - không chia sẻ, mỗi môi trường một giá trị riêng
#    [RECOMMENDED] 🟡 Nên cấu hình - có giá trị mặc định nhưng nên chỉnh theo môi trường
#    [OPTIONAL]    🟢 Tuỳ chọn - để trống thì tính năng liên quan bị tắt
#  Ghi chú [auto-generate]: `npm run setup` / `npm run env:sync` tự sinh giá trị ngẫu nhiên.
# =============================================================================


# ============================== APP ==========================================

# NODE_ENV
#   Ý nghĩa  : Môi trường chạy (development | test | production). Ảnh hưởng log, cookie, index DB.
#   Cách tạo : Local để development; server thật đặt production.
#   Mức độ   : [RECOMMENDED]
NODE_ENV=development

# PORT
#   Ý nghĩa  : Cổng HTTP mà API lắng nghe.
#   Cách tạo : Chọn cổng trống. Nếu đổi, cập nhật DEV_API_PROXY_TARGET ở frontend/.env.
#   Mức độ   : [RECOMMENDED]
PORT=8000

# APP_NAME
#   Ý nghĩa  : Tên ứng dụng - hiển thị trong email, log và làm "issuer" của JWT.
#   Cách tạo : Đặt tên dự án. Đổi giá trị sẽ làm access token cũ mất hiệu lực.
#   Mức độ   : [RECOMMENDED]
APP_NAME=Source Base

# API_PUBLIC_URL
#   Ý nghĩa  : URL công khai của backend. Dùng tạo OAuth callback URL:
#              <API_PUBLIC_URL>/api/v1/auth/oauth/<provider>/callback
#   Cách tạo : Local: http://localhost:<PORT>. Production: https://api.domain.com
#   Mức độ   : [REQUIRED] (khi bật OAuth)
API_PUBLIC_URL=http://localhost:8000

# FRONTEND_URL
#   Ý nghĩa  : URL frontend. Dùng tạo link trong email (magic link, reset password...)
#              và redirect sau OAuth.
#   Cách tạo : Local: http://localhost:5173 (Vite). Production: https://app.domain.com
#   Mức độ   : [REQUIRED]
FRONTEND_URL=http://localhost:5173

# CORS_ORIGINS
#   Ý nghĩa  : Danh sách origin được phép gọi API (có gửi cookie), cách nhau bởi dấu phẩy.
#   Cách tạo : Thường bằng FRONTEND_URL. Ví dụ: https://app.domain.com,https://admin.domain.com
#   Mức độ   : [REQUIRED]
CORS_ORIGINS=http://localhost:5173

# TRUST_PROXY
#   Ý nghĩa  : Số lớp reverse proxy (Nginx, Cloudflare, load balancer) đứng trước app.
#              Cần đúng để lấy IP thật của client (rate limit, lưu session).
#   Cách tạo : Local: 0. Sau 1 proxy (Nginx/Render/Railway): 1.
#   Mức độ   : [RECOMMENDED]
TRUST_PROXY=0

# LOG_LEVEL
#   Ý nghĩa  : Mức log tối thiểu (fatal | error | warn | info | debug | trace | silent).
#   Cách tạo : Dev: debug hoặc info. Production: info hoặc warn.
#   Mức độ   : [OPTIONAL]
LOG_LEVEL=info


# ============================== DATABASE =====================================

# MONGODB_URI
#   Ý nghĩa  : Chuỗi kết nối MongoDB (gồm tên database).
#   Cách tạo : • Local: cài MongoDB Community -> mongodb://127.0.0.1:27017/source_base
#              • MongoDB Atlas: Cluster -> Connect -> Drivers -> copy URI dạng
#                mongodb+srv://<user>:<password>@<cluster>.mongodb.net/<db>?retryWrites=true&w=majority
#                (nhớ whitelist IP ở Network Access)
#   Mức độ   : [SECRET] (chứa mật khẩu DB)
MONGODB_URI=mongodb://127.0.0.1:27017/source_base


# ============================== AUTH / SECURITY ==============================

# JWT_ACCESS_SECRET
#   Ý nghĩa  : Khoá ký access token (JWT HS256). Lộ khoá = kẻ xấu giả mạo được mọi tài khoản.
#   Cách tạo : Tối thiểu 32 ký tự ngẫu nhiên:
#              node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
#              Đổi khoá => mọi access token hiện tại mất hiệu lực (user tự refresh lại).
#   Mức độ   : [SECRET] [auto-generate]
JWT_ACCESS_SECRET=

# JWT_ACCESS_EXPIRES_IN
#   Ý nghĩa  : Thời gian sống của access token. Ngắn = an toàn hơn (frontend tự refresh).
#   Cách tạo : Định dạng <số><đơn vị> với đơn vị ms|s|m|h|d|w. Khuyến nghị 10m-30m.
#   Mức độ   : [RECOMMENDED]
JWT_ACCESS_EXPIRES_IN=15m

# REFRESH_TOKEN_EXPIRES_IN
#   Ý nghĩa  : Thời gian sống của phiên đăng nhập (refresh token trong cookie httpOnly).
#              Tự gia hạn mỗi lần refresh (sliding expiration).
#   Cách tạo : Khuyến nghị 7d-30d.
#   Mức độ   : [RECOMMENDED]
REFRESH_TOKEN_EXPIRES_IN=7d

# COOKIE_SECRET
#   Ý nghĩa  : Khoá ký cookie (signed cookie) - dùng cho cookie state của OAuth.
#   Cách tạo : Giống JWT_ACCESS_SECRET nhưng PHẢI là giá trị khác.
#   Mức độ   : [SECRET] [auto-generate]
COOKIE_SECRET=

# COOKIE_SECURE
#   Ý nghĩa  : true = cookie chỉ gửi qua HTTPS. Production BẮT BUỘC true (app sẽ báo lỗi nếu false).
#   Cách tạo : Local (http): false. Production (https): true.
#   Mức độ   : [REQUIRED]
COOKIE_SECURE=false

# COOKIE_SAME_SITE
#   Ý nghĩa  : Chính sách SameSite của cookie (lax | strict | none).
#   Cách tạo : • FE và BE cùng site (app.domain.com + api.domain.com, hoặc dùng proxy): lax
#              • FE và BE khác site (vercel.app + onrender.com): none (bắt buộc COOKIE_SECURE=true)
#   Mức độ   : [RECOMMENDED]
COOKIE_SAME_SITE=lax

# MAGIC_LINK_EXPIRES_IN
#   Ý nghĩa  : Hạn dùng của link đăng nhập gửi qua email (magic link).
#   Cách tạo : Khuyến nghị 10m-30m.
#   Mức độ   : [OPTIONAL]
MAGIC_LINK_EXPIRES_IN=15m

# EMAIL_VERIFY_EXPIRES_IN
#   Ý nghĩa  : Hạn dùng của link xác thực email sau khi đăng ký.
#   Cách tạo : Khuyến nghị 24h-72h.
#   Mức độ   : [OPTIONAL]
EMAIL_VERIFY_EXPIRES_IN=24h

# PASSWORD_RESET_EXPIRES_IN
#   Ý nghĩa  : Hạn dùng của link đặt lại mật khẩu.
#   Cách tạo : Khuyến nghị 15m-60m.
#   Mức độ   : [OPTIONAL]
PASSWORD_RESET_EXPIRES_IN=30m


# ============================== OAUTH ========================================
# Để trống cặp CLIENT_ID/CLIENT_SECRET => tắt provider đó (nút đăng nhập tự ẩn ở frontend).
# Phải khai báo ĐỦ CẶP, khai báo một nửa app sẽ báo lỗi.

# GOOGLE_CLIENT_ID
#   Ý nghĩa  : OAuth Client ID của Google.
#   Cách tạo : https://console.cloud.google.com -> APIs & Services -> Credentials
#              -> Create Credentials -> OAuth client ID -> Web application
#              -> Authorized redirect URIs: http://localhost:8000/api/v1/auth/oauth/google/callback
#   Mức độ   : [OPTIONAL]
GOOGLE_CLIENT_ID=

# GOOGLE_CLIENT_SECRET
#   Ý nghĩa  : OAuth Client Secret của Google (tạo cùng lúc với GOOGLE_CLIENT_ID).
#   Cách tạo : Copy từ màn hình tạo OAuth client ở trên.
#   Mức độ   : [OPTIONAL] (bí mật nếu dùng)
GOOGLE_CLIENT_SECRET=

# GITHUB_CLIENT_ID
#   Ý nghĩa  : OAuth App Client ID của GitHub.
#   Cách tạo : https://github.com/settings/developers -> OAuth Apps -> New OAuth App
#              -> Authorization callback URL: http://localhost:8000/api/v1/auth/oauth/github/callback
#   Mức độ   : [OPTIONAL]
GITHUB_CLIENT_ID=

# GITHUB_CLIENT_SECRET
#   Ý nghĩa  : OAuth App Client Secret của GitHub.
#   Cách tạo : Trong trang OAuth App -> Generate a new client secret.
#   Mức độ   : [OPTIONAL] (bí mật nếu dùng)
GITHUB_CLIENT_SECRET=


# ============================== MAIL =========================================

# MAIL_DRIVER
#   Ý nghĩa  : Cách gửi email. console = in nội dung email (kèm link) ra log backend;
#              memory = lưu trong RAM (dùng cho test). Phase Mail sẽ thêm smtp/resend.
#   Cách tạo : Local: console (mở terminal backend để lấy link magic/reset).
#   Mức độ   : [RECOMMENDED]
MAIL_DRIVER=console

# MAIL_FROM
#   Ý nghĩa  : Địa chỉ người gửi hiển thị trong email.
#   Cách tạo : Dạng "Tên <email@domain>". Domain phải được xác thực ở nhà cung cấp mail (phase Mail).
#   Mức độ   : [RECOMMENDED]
MAIL_FROM=Source Base <no-reply@example.com>


# ============================== RATE LIMIT ===================================

# RATE_LIMIT_WINDOW_MS
#   Ý nghĩa  : Cửa sổ thời gian (mili-giây) để đếm số request mỗi IP.
#   Cách tạo : Mặc định 900000 (15 phút).
#   Mức độ   : [OPTIONAL]
RATE_LIMIT_WINDOW_MS=900000

# RATE_LIMIT_MAX
#   Ý nghĩa  : Số request tối đa / IP / cửa sổ cho toàn bộ API.
#   Cách tạo : Tăng nếu app gọi API dày đặc; giảm để chống spam.
#   Mức độ   : [OPTIONAL]
RATE_LIMIT_MAX=300

# AUTH_RATE_LIMIT_MAX
#   Ý nghĩa  : Số request tối đa / IP / cửa sổ cho endpoint nhạy cảm (login, register, gửi mail...).
#              Chống brute-force mật khẩu và spam email.
#   Cách tạo : Khuyến nghị 10-30.
#   Mức độ   : [RECOMMENDED]
AUTH_RATE_LIMIT_MAX=20


# ============================== SEED =========================================
# Chỉ dùng cho `npm run seed` (tạo tài khoản superAdmin đầu tiên). Server không đọc các biến này.

# SUPER_ADMIN_NAME
#   Ý nghĩa  : Tên hiển thị của superAdmin được seed.
#   Cách tạo : Tuỳ ý.
#   Mức độ   : [OPTIONAL]
SUPER_ADMIN_NAME=Super Admin

# SUPER_ADMIN_EMAIL
#   Ý nghĩa  : Email đăng nhập của superAdmin. Seed sẽ tạo mới hoặc nâng quyền user có email này.
#   Cách tạo : Email thật của người quản trị hệ thống.
#   Mức độ   : [REQUIRED] (khi chạy seed)
SUPER_ADMIN_EMAIL=superadmin@example.com

# SUPER_ADMIN_PASSWORD
#   Ý nghĩa  : Mật khẩu ban đầu của superAdmin (>= 8 ký tự, có chữ và số).
#   Cách tạo : `npm run setup` tự sinh; xem giá trị trong backend/.env. Đổi mật khẩu sau lần đăng nhập đầu.
#   Mức độ   : [SECRET] [auto-generate]
SUPER_ADMIN_PASSWORD=
