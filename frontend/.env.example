# =============================================================================
#  FRONTEND ENVIRONMENT - FILE MẪU (được commit lên git)
# -----------------------------------------------------------------------------
#  • Tạo file .env thật:   npm run setup
#  • Kiểm tra đồng bộ:     npm run env:check
#  • Biến VITE_* được nhúng vào bundle JS => AI CŨNG ĐỌC ĐƯỢC. TUYỆT ĐỐI không đặt secret ở đây.
#  • Biến DEV_* chỉ dùng trong vite.config.js (dev server), không lộ ra trình duyệt.
#  • Thêm biến VITE_* mới: sửa file này + frontend/src/core/config/env.js (test sẽ báo nếu lệch)
#
#  Mức độ: [REQUIRED] 🔴 bắt buộc | [RECOMMENDED] 🟡 nên cấu hình | [OPTIONAL] 🟢 tuỳ chọn
# =============================================================================

# VITE_APP_NAME
#   Ý nghĩa  : Tên ứng dụng hiển thị trên header, tiêu đề tab trình duyệt.
#   Cách tạo : Đặt tên dự án (nên trùng APP_NAME của backend).
#   Mức độ   : [RECOMMENDED]
VITE_APP_NAME=Source Base

# VITE_API_URL
#   Ý nghĩa  : Base URL mà frontend gọi API.
#   Cách tạo : • Dev (dùng proxy của Vite): /api/v1
#              • Production khác domain: https://api.domain.com/api/v1
#                (khi đó backend cần CORS_ORIGINS chứa domain frontend, COOKIE_SAME_SITE phù hợp)
#   Mức độ   : [REQUIRED]
VITE_API_URL=/api/v1

# VITE_API_TIMEOUT
#   Ý nghĩa  : Thời gian chờ tối đa mỗi request API (mili-giây).
#   Cách tạo : Mặc định 15000 (15 giây).
#   Mức độ   : [OPTIONAL]
VITE_API_TIMEOUT=15000

# VITE_ENABLE_QUERY_DEVTOOLS
#   Ý nghĩa  : Bật TanStack Query Devtools (nút nổi góc màn hình để xem cache/query).
#   Cách tạo : true khi dev, false (hoặc bỏ trống) ở production.
#   Mức độ   : [OPTIONAL]
VITE_ENABLE_QUERY_DEVTOOLS=true

# DEV_PORT
#   Ý nghĩa  : Cổng của Vite dev server / preview.
#   Cách tạo : Mặc định 5173. Nếu đổi, cập nhật FRONTEND_URL + CORS_ORIGINS ở backend/.env.
#   Mức độ   : [OPTIONAL]
DEV_PORT=5173

# DEV_API_PROXY_TARGET
#   Ý nghĩa  : Địa chỉ backend mà Vite proxy chuyển tiếp các request /api khi dev.
#   Cách tạo : http://localhost:<PORT của backend>
#   Mức độ   : [RECOMMENDED]
DEV_API_PROXY_TARGET=http://localhost:8000
