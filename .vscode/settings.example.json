{
  "editor.defaultFormatter": "esbenp.prettier-vscode",
  "editor.formatOnSave": true,
  "editor.codeActionsOnSave": {
    "source.fixAll.eslint": "explicit"
  },
  "eslint.useFlatConfig": true,
  "files.eol": "\n",
  "tailwindCSS.experimental.classRegex": [["cn\(([^)]*)\)", "[\"'`]([^\"'`]*).*?[\"'`]"]],
  "search.exclude": {
    "**/node_modules": true,
    "**/dist": true,
    "**/coverage": true,
    ".backup": true
  }
}
